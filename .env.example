# Optional Go process settings. Export them before running the binary;
# the application does not automatically load .env files.
PERFMAN_ADDR=127.0.0.1:8099
# Relative to the process working directory (normally studio/).
PERFMAN_DATA=data/workspace.db
# Set only before creating a new database; does not reset existing accounts.
# PERFMAN_INITIAL_PASSWORD=replace-with-your-initial-password
